generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  firebaseUid  String   @unique
  name         String
  email        String   @unique
  profileImage String?
  createdAt    DateTime @default(now())

  groupsCreated Group[]       @relation("GroupAdmin")
  memberships   GroupMember[]
  addedSpots    GroupSpot[]   @relation("SpotAddedBy")
  votes         SpotVote[]
  soloPlans     SoloPlan[]
  messages      GroupMessage[]
}

model Group {
  id          String   @id @default(cuid())
  name        String
  region      String
  adminId     String
  inviteToken String   @unique
  visitDate   String?
  startLocation String?
  createdAt   DateTime @default(now())

  admin   User          @relation("GroupAdmin", fields: [adminId], references: [id])
  members GroupMember[]
  spots   GroupSpot[]
  messages GroupMessage[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  latitude           Float?
  longitude          Float?
  lastLocationUpdate DateTime?
  isSharingLocation  Boolean   @default(false)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  text      String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model PujaSpot {
  id          String  @id @default(cuid())
  externalId  String  @unique
  name        String
  area        String
  region      String
  address     String?
  nearestMetro String?
  latitude    Float?
  longitude   Float?
  description String?
  image       String?
  category    String  @default("Community Puja")
  crowdLevel  String  @default("Moderate")
  source      String?

  groupSpots    GroupSpot[]
  soloPlanSpots SoloPlanSpot[]
}

model GroupSpot {
  id        String   @id @default(cuid())
  groupId   String
  spotId    String
  addedById String
  status    String   @default("suggested")
  createdAt DateTime @default(now())

  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  spot    PujaSpot @relation(fields: [spotId], references: [id])
  addedBy User     @relation("SpotAddedBy", fields: [addedById], references: [id])
  votes   SpotVote[]

  @@unique([groupId, spotId])
}

model SpotVote {
  id          String   @id @default(cuid())
  groupSpotId String
  userId      String
  createdAt   DateTime @default(now())

  groupSpot GroupSpot @relation(fields: [groupSpotId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupSpotId, userId])
}

model SoloPlan {
  id            String   @id @default(cuid())
  userId        String
  name          String   @default("My Puja Plan")
  region        String
  startLocation String?
  visitDate     String?
  createdAt     DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  spots SoloPlanSpot[]
}

model SoloPlanSpot {
  id         String @id @default(cuid())
  planId     String
  spotId     String
  visitOrder Int    @default(0)

  plan SoloPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  spot PujaSpot @relation(fields: [spotId], references: [id])

  @@unique([planId, spotId])
}
