# ─── MongoDB Atlas Connection String ──────────────────────────────
# Replace with your connection string from MongoDB Atlas:
# e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/pujoplan?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pujoplan?retryWrites=true&w=majority

# ─── Server Configuration ─────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Firebase Admin SDK (Optional / Recommended for Token Verification) ──
FIREBASE_PROJECT_ID=pujoplan-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@pujoplan-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

JWT_SECRET=pujoplan_jwt_secret_key_change_in_production
